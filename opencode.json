{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "git commit --amend": "deny",
      "git commit --amend *": "deny",
      "git push --force-with-lease": "deny",
      "git push --force-with-lease *": "deny",
      "git push -f": "deny",
      "git push -f *": "deny",
      "git push --force": "deny",
      "git push --force *": "deny",
      "git rebase -i": "deny",
      "git rebase -i *": "deny"
    }
  }
}
